# CI hirebot: линтер, типы, тесты, миграции, зависимости, валидация деплоя.
#
# Принципы:
#   * ни один job не требует внешней инфраструктуры: тесты идут на SQLite и
#     fake-адаптерах. PostgreSQL — отдельный ручной job (он не блокирует CI);
#   * версии Python и uv фиксированы, зависимости ставятся через uv с кэшем;
#   * security (pip-audit) не блокирует сборку: сеть до PyPI в CI может быть
#     недоступна, и красный CI из-за этого не должен останавливать релиз.

name: CI

on:
  push:
    branches: [main, master]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  PYTHON_VERSION: "3.12"

jobs:
  # ------------------------------------------------------------------------ #
  # Линтер и форматирование
  # ------------------------------------------------------------------------ #
  lint:
    name: Линтер (ruff)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Установить uv (с кэшем зависимостей)
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
          cache-dependency-glob: pyproject.toml

      - name: Создать окружение и установить зависимости
        run: |
          uv venv --python "$PYTHON_VERSION"
          uv pip install -e ".[dev]"

      - name: ruff check
        run: .venv/bin/python -m ruff check src tests

      - name: ruff format --check
        run: .venv/bin/python -m ruff format --check src tests

  # ------------------------------------------------------------------------ #
  # Типы (mypy strict, см. [tool.mypy] в pyproject.toml)
  # ------------------------------------------------------------------------ #
  types:
    name: Типы (mypy strict)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Установить uv (с кэшем зависимостей)
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
          cache-dependency-glob: pyproject.toml

      - name: Создать окружение и установить зависимости
        run: |
          uv venv --python "$PYTHON_VERSION"
          uv pip install -e ".[dev]"

      - name: mypy src/hirebot
        run: .venv/bin/python -m mypy src/hirebot

  # ------------------------------------------------------------------------ #
  # Тесты и покрытие
  # ------------------------------------------------------------------------ #
  test:
    name: Тесты (pytest + покрытие)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Установить uv (с кэшем зависимостей)
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
          cache-dependency-glob: pyproject.toml

      - name: Создать окружение и установить зависимости
        run: |
          uv venv --python "$PYTHON_VERSION"
          uv pip install -e ".[dev]"

      # Сетевые тесты исключены маркером "network": они ходят в реальные API.
      # Внешняя инфраструктура не нужна: unit- и integration-тесты работают на
      # SQLite в памяти и fake-адаптерах.
      - name: pytest
        env:
          HIREBOT_ENV: test
        run: |
          mkdir -p reports
          .venv/bin/python -m pytest -q -m "not network" \
            --cov=src/hirebot \
            --cov-report=term-missing \
            --cov-report=xml:reports/coverage.xml \
            --junitxml=reports/junit.xml

      - name: Загрузить отчёты покрытия и тестов
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage-reports
          path: |
            reports/coverage.xml
            reports/junit.xml
          if-no-files-found: warn
          retention-days: 14

  # ------------------------------------------------------------------------ #
  # Миграции: схема из миграций должна совпадать с моделями
  # ------------------------------------------------------------------------ #
  migrations:
    name: Миграции (SQLite)
    runs-on: ubuntu-latest
    env:
      HIREBOT_ENV: test
      HIREBOT_DATABASE__DSN: sqlite+aiosqlite:///./ci-migrations.db
    steps:
      - uses: actions/checkout@v4

      - name: Установить uv (с кэшем зависимостей)
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
          cache-dependency-glob: pyproject.toml

      - name: Создать окружение и установить зависимости
        run: |
          uv venv --python "$PYTHON_VERSION"
          uv pip install -e ".[dev]"

      - name: Накатить миграции на чистую БД
        run: .venv/bin/python -m alembic upgrade head

      - name: Проверить, что модели и миграции не разошлись
        run: .venv/bin/python -m alembic check

      - name: Показать текущую ревизию
        run: .venv/bin/python -m alembic current

  # ------------------------------------------------------------------------ #
  # Прод-конфигурация: YAML и compose-файл должны быть валидны
  # ------------------------------------------------------------------------ #
  deploy-config:
    name: Конфигурация деплоя
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Установить uv
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
          cache-dependency-glob: pyproject.toml

      - name: Создать окружение
        run: uv venv --python "$PYTHON_VERSION"

      - name: Разобрать YAML-файлы деплоя
        run: |
          uv pip install pyyaml
          .venv/bin/python - <<'PY'
          from pathlib import Path

          import yaml

          for path in sorted(Path("deploy").glob("*.yml")) + sorted(Path("deploy").glob("*.yaml")):
              with path.open(encoding="utf-8") as handle:
                  yaml.safe_load(handle)
              print("ok:", path)
          PY

      - name: Проверить compose-файл (без запуска контейнеров)
        run: |
          cat > /tmp/deploy.env <<'ENV'
          POSTGRES_PASSWORD=ci-postgres-password
          REDIS_PASSWORD=ci-redis-password
          HIREBOT_SECURITY__PII_KEY=ci-fernet-key-placeholder
          HIREBOT_SECURITY__WEBHOOK_SECRET=ci-webhook-secret
          ENV
          # `config` подставляет переменные и проверяет схему compose-файла;
          # демон Docker для этого не нужен.
          docker compose -f deploy/docker-compose.prod.yml --env-file /tmp/deploy.env config -q

  # ------------------------------------------------------------------------ #
  # Уязвимости зависимостей. Не блокирует: PyPI может быть недоступен.
  # ------------------------------------------------------------------------ #
  security:
    name: Аудит зависимостей (pip-audit)
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - uses: actions/checkout@v4

      - name: Установить uv (с кэшем зависимостей)
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
          cache-dependency-glob: pyproject.toml

      - name: Создать окружение
        run: uv venv --python "$PYTHON_VERSION"

      - name: Собрать список зависимостей (включая dev)
        run: |
          uv pip compile pyproject.toml --extra dev -o requirements-audit.txt
          uv pip install pip-audit

      - name: pip-audit
        run: .venv/bin/python -m pip_audit -r requirements-audit.txt --skip-editable --format columns

  # ------------------------------------------------------------------------ #
  # PostgreSQL: миграции на реальной целевой СУБД. Ручной запуск, не блокирует.
  # ------------------------------------------------------------------------ #
  migrations-postgres:
    name: Миграции (PostgreSQL, ручной запуск)
    if: github.event_name == 'workflow_dispatch'
    continue-on-error: true
    runs-on: ubuntu-latest
    env:
      HIREBOT_ENV: test
      HIREBOT_DATABASE__DSN: postgresql+asyncpg://hirebot:hirebot@localhost:5432/hirebot
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: hirebot
          POSTGRES_PASSWORD: hirebot
          POSTGRES_DB: hirebot
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U hirebot -d hirebot"
          --health-interval 5s
          --health-timeout 3s
          --health-retries 20
    steps:
      - uses: actions/checkout@v4

      - name: Установить uv (с кэшем зависимостей)
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
          cache-dependency-glob: pyproject.toml

      - name: Создать окружение и установить зависимости
        run: |
          uv venv --python "$PYTHON_VERSION"
          uv pip install -e ".[dev]"

      - name: Миграции на PostgreSQL
        run: |
          .venv/bin/python -m alembic upgrade head
          .venv/bin/python -m alembic check

      - name: Проверить обратимость миграций
        run: |
          .venv/bin/python -m alembic downgrade base
          .venv/bin/python -m alembic upgrade head
