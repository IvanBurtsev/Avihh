# Переменные продакшен-развёртывания hirebot.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# Файл используется дважды: docker compose читает его для подстановки значений
# (${POSTGRES_PASSWORD} и т.п.), а сервисы получают его как env_file. В git этот
# файл не попадает (deploy/.env уже в .gitignore проекта) — секреты живут только
# на сервере.
#
# Правила, без которых система не поднимется:
#   * HIREBOT_ENV=production проверяет сама себя при старте (hirebot/config.py):
#     DSN должен вести в PostgreSQL, PII_KEY должен быть задан, очередь — arq.
#   * HIREBOT_SECURITY__WEBHOOK_SECRET — это же и есть X-API-Key для защищённых
#     эндпоинтов, включая /metrics: без него API отвечает 503 на них.

# --------------------------------------------------------------------------- #
# Инфраструктура (пароли генерируйте заново, не переиспользуйте эти примеры)
# --------------------------------------------------------------------------- #
POSTGRES_USER=hirebot
POSTGRES_DB=hirebot
# Пароль попадает в DSN (postgresql://user:ПАРОЛЬ@host/db), поэтому только
# URL-безопасные символы: openssl rand -hex 32 (base64 содержит +/= и ломает DSN).
POSTGRES_PASSWORD=
# openssl rand -hex 32
REDIS_PASSWORD=

# --------------------------------------------------------------------------- #
# Обязательные секреты приложения
# --------------------------------------------------------------------------- #
# 32 байта base64 (Fernet). Генерация:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: смена ключа делает ранее зашифрованные ПДн нечитаемыми. Ротация —
# только по отдельной процедуре (см. docs/RUNBOOK.md), не «на всякий случай».
HIREBOT_SECURITY__PII_KEY=
# Ключ для X-API-Key: административный API, UI-действия и /metrics.
#   openssl rand -hex 32
HIREBOT_SECURITY__WEBHOOK_SECRET=

# --------------------------------------------------------------------------- #
# Логи и окружение
# --------------------------------------------------------------------------- #
HIREBOT_LOG_LEVEL=INFO
HIREBOT_LOG_JSON=true

# --------------------------------------------------------------------------- #
# LLM (для production нельзя fake: Settings требует ключ)
# --------------------------------------------------------------------------- #
HIREBOT_LLM__PROVIDER=openai_compat
HIREBOT_LLM__BASE_URL=https://api.openai.com/v1
HIREBOT_LLM__MODEL=gpt-4o-mini
HIREBOT_LLM__API_KEY=
# ПДн в зарубежную модель не отправляем: только обезличенный текст (152-ФЗ).
HIREBOT_LLM__SEND_PII=false
HIREBOT_LLM__TIMEOUT_S=60
HIREBOT_LLM__MAX_RETRIES=3

# --------------------------------------------------------------------------- #
# HH.ru (официальный Employer API)
# --------------------------------------------------------------------------- #
HIREBOT_HH__ENABLED=false
HIREBOT_HH__CLIENT_ID=
HIREBOT_HH__CLIENT_SECRET=
HIREBOT_HH__ACCESS_TOKEN=
HIREBOT_HH__REFRESH_TOKEN=
# Лимиты исходящих запросов. Правильные имена полей вложенные:
#   HIREBOT_HH__RATE_LIMIT__REQUESTS_PER_SECOND / __BURST
HIREBOT_HH__RATE_LIMIT__REQUESTS_PER_SECOND=3
HIREBOT_HH__RATE_LIMIT__BURST=5

# --------------------------------------------------------------------------- #
# Avito
# --------------------------------------------------------------------------- #
HIREBOT_AVITO__ENABLED=false
HIREBOT_AVITO__CLIENT_ID=
HIREBOT_AVITO__CLIENT_SECRET=
HIREBOT_AVITO__ACCESS_TOKEN=
HIREBOT_AVITO__RATE_LIMIT__REQUESTS_PER_SECOND=1
HIREBOT_AVITO__RATE_LIMIT__BURST=3

# --------------------------------------------------------------------------- #
# Talantix (календарь, GraphQL). Токены выдаёт администратор Talantix.
# --------------------------------------------------------------------------- #
HIREBOT_TALANTIX__ENABLED=false
HIREBOT_TALANTIX__ACCESS_TOKEN=
HIREBOT_TALANTIX__REFRESH_TOKEN=
HIREBOT_TALANTIX__MAX_WINDOW_DAYS=90
HIREBOT_TALANTIX__DEFAULT_TIMEZONE=Europe/Moscow

# --------------------------------------------------------------------------- #
# Политика автономности бота (152-ФЗ / ТК РФ)
# --------------------------------------------------------------------------- #
HIREBOT_POLICY__REQUIRE_HUMAN_APPROVAL=false
HIREBOT_POLICY__MAX_AUTO_MESSAGES_PER_CANDIDATE=4
HIREBOT_POLICY__MIN_SCORE_TO_INVITE=70
# Автоотказ по умолчанию выключен: включать только с юридической проверкой.
HIREBOT_POLICY__AUTO_REJECT_ENABLED=false

# --------------------------------------------------------------------------- #
# Необязательные настройки compose (значения по умолчанию — в compose-файле)
# --------------------------------------------------------------------------- #
HIREBOT_IMAGE=hirebot
HIREBOT_TAG=latest
HIREBOT_HOST_PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
