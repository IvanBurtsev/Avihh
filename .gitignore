# Выгрузки с персональными данными кандидатов — никогда в git
data/
exports/
*.csv
*.xlsx

# ...кроме эталонной выборки для замера качества: это не ПДн, а размеченный
# тестовый набор, и он обязан версионироваться вместе с кодом.
!data/
!data/evaluation/
!data/evaluation/**
