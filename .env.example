# Скопируйте в .env и заполните. .env в .gitignore — секреты в репозиторий не попадают.
# Все переменные читаются с префиксом HIREBOT_, вложенность — через двойное подчёркивание:
#   HH__CLIENT_ID  ->  settings.hh.client_id

HIREBOT_ENV=local
HIREBOT_LOG_LEVEL=INFO
HIREBOT_LOG_JSON=true

# --- Инфраструктура ---------------------------------------------------------
HIREBOT_DATABASE__DSN=postgresql+asyncpg://hirebot:hirebot@localhost:5433/hirebot
HIREBOT_REDIS__DSN=redis://localhost:6380/0
# Для запуска демо без Docker: sqlite+aiosqlite:///./hirebot.db  (worker: HIREBOT_QUEUE__BACKEND=inline)

# --- Шифрование ПДн и доступ -------------------------------------------------
# 32 байта base64. Сгенерировать: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
HIREBOT_SECURITY__PII_KEY=
# Ключ доступа: заголовок X-API-Key для API и /metrics, пароль входа в /ui.
# В production обязателен — без него сервис не стартует.
HIREBOT_SECURITY__WEBHOOK_SECRET=

# --- HH.ru (официальный Employer API) --------------------------------------
# Приложение регистрируется на https://dev.hh.ru/admin
HIREBOT_HH__ENABLED=false
HIREBOT_HH__CLIENT_ID=
HIREBOT_HH__CLIENT_SECRET=
# Токен работодателя, полученный по authorization_code. НЕ храните логин/пароль
# пользователя: это прямо запрещено условиями API hh.ru.
HIREBOT_HH__ACCESS_TOKEN=
HIREBOT_HH__REFRESH_TOKEN=
HIREBOT_HH__RATE_LIMIT__REQUESTS_PER_SECOND=3
HIREBOT_HH__RATE_LIMIT__BURST=5

# --- Avito ------------------------------------------------------------------
HIREBOT_AVITO__ENABLED=false
HIREBOT_AVITO__CLIENT_ID=
HIREBOT_AVITO__CLIENT_SECRET=
HIREBOT_AVITO__ACCESS_TOKEN=

# --- Talantix (GraphQL) -----------------------------------------------------
HIREBOT_TALANTIX__ENABLED=false
HIREBOT_TALANTIX__ACCESS_TOKEN=
HIREBOT_TALANTIX__REFRESH_TOKEN=

# --- LLM --------------------------------------------------------------------
# provider: fake | openai_compat
HIREBOT_LLM__PROVIDER=fake
HIREBOT_LLM__MODEL=gpt-4o-mini
HIREBOT_LLM__BASE_URL=https://api.openai.com/v1
HIREBOT_LLM__API_KEY=

# --- Политика автоответов ---------------------------------------------------
# Сколько сообщений бот может отправить кандидату без просмотра человеком.
HIREBOT_POLICY__MAX_AUTO_MESSAGES_PER_CANDIDATE=4
HIREBOT_POLICY__AUTO_REJECT_ENABLED=false
HIREBOT_POLICY__MIN_SCORE_TO_INVITE=70
HIREBOT_POLICY__REQUIRE_HUMAN_APPROVAL=false

# --- Сроки хранения ПДн (152-ФЗ) --------------------------------------------
# После истечения срока данные удаляются задачей: hirebot privacy purge
HIREBOT_PRIVACY__RESUME_RETENTION_DAYS=180
HIREBOT_PRIVACY__MESSAGE_RETENTION_DAYS=365
HIREBOT_PRIVACY__SCREENING_RETENTION_DAYS=365
HIREBOT_PRIVACY__AUDIT_RETENTION_DAYS=730
HIREBOT_PRIVACY__DRAFT_RETENTION_DAYS=30
